# Configurações do Ambiente
# Define o ambiente em que a aplicação está rodando. 
ENVIRONMENT=local # Opções: 'local', 'docker'

# Configurações do Banco de Dados PostgreSQL
POSTGRES_USER=user # Usuário do banco de dados
POSTGRES_PASSWORD=senha # Senha do banco de dados
POSTGRES_DB=database # Nome do banco de dados

# Host do banco de dados
# Use 'localhost' para desenvolvimento local ou o nome do serviço docker ('db') em ambiente containerizado
POSTGRES_HOST_LOCAL=localhost
POSTGRES_HOST_DOCKER=db # Host do banco de dados no ambiente Docker
POSTGRES_PORT=5432 # Porta do banco de dados no docker

# Configurações de Autenticação JWT
# Chave secreta para assinar os tokens JWT. Deve ser mantida em segredo.
# Você pode gerar uma nova chave com: openssl rand -hex 32
SECRET_KEY=secret_key # Substitua por uma chave secreta forte
