# ==========================================
# CONFIGURAÇÕES DE AMBIENTE - FRONTEND (VITE)
# Projeto: Sabor Match
# ==========================================

# ATENÇÃO: O frontend (React) roda no NAVEGADOR do usuário, e não dentro da rede do Docker!
# Portanto, as URLs da API precisam ser endereços que o navegador consiga acessar.

# 1. Configuração de Host e Porta da API (FastAPI)
# - Para testar apenas no seu próprio computador: mantenha "localhost"
# - Para testar no celular (mesmo Wi-Fi): troque "localhost" pelo IP da sua máquina (ex: 192.168.0.10)
VITE_SABOR_MATCH_HOST=localhost
VITE_SABOR_MATCH_PORT=8000

# 2. URL Base do Backend (Montagem Automática)
# O Vite expande as variáveis acima para montar a URL completa. O "http://" é obrigatório.
# Esta é a variável final que deve ser chamada nas requisições do frontend.
VITE_SABOR_MATCH_API=http://${VITE_SABOR_MATCH_HOST}:${VITE_SABOR_MATCH_PORT}

# IMPORTANTE PARA O CÓDIGO REACT:
# Para acessar essa URL nos seus arquivos .js/.ts (usando Axios ou Fetch), utilize:
# import.meta.env.VITE_SABOR_MATCH_API